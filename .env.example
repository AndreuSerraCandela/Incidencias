# Copia este archivo a .env y rellena los valores reales.
# cp .env.example .env

# Flask
FLASK_SECRET_KEY=cambiar_en_produccion

# Business Central
BC_BASE_URL=https://bc220.malla.es
BC_ENDPOINT=/powerbi/ODataV4/GtaskMalla_PostFijacion
BC_ENDPOINT_INCIDENCES=/powerbi/ODataV4/GtaskMalla_PostIncidencia
BC_COMPANY=Malla Publicidad
BC_USERNAME=
BC_PASSWORD=
BC_TIMEOUT=120
BC_TIMEOUT_LARGE_IMAGES=300
BC_MAX_IMAGE_SIZE_MB=10
BC_COMPRESS_QUALITY=85
BC_ENABLE_COMPRESSION=true

# SQL Server GIS (MobiliarioGis / RecursosGis)
GIS_SQL_SERVER=192.168.10.190
GIS_SQL_DATABASE=Malla2009
GIS_SQL_USERNAME=
GIS_SQL_PASSWORD=

# LM Studio (visión / IA)
LM_STUDIO_URL=http://192.168.10.238:1234/v1/chat/completions

# SSO desde portal Malla (mismo MALLA_SSO_SECRET que apps.malla.es)
# MALLA_SSO_SECRET=mismo-valor-que-appdesktop
